{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores student profile information and metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Student email address" },
        "displayName": { "type": "string", "description": "Student name" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["student", "admin"], "description": "User role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation time" },
        "lastLogin": { "type": "string", "format": "date-time", "description": "Last login time" }
      },
      "required": ["uid", "email", "role"]
    },
    "stories": {
      "title": "Generated Story",
      "description": "Stores stories generated by students for tracking and review.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique story ID" },
        "userId": { "type": "string", "description": "UID of the student who generated the story" },
        "title": { "type": "string", "description": "Story title" },
        "content": { "type": "string", "description": "Full story text" },
        "language": { "type": "string", "description": "Language of the story" },
        "topic": { "type": "string", "description": "Story topic/prompt" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Generation time" }
      },
      "required": ["userId", "title", "content", "language", "topic", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Individual student profile documents."
    },
    "/stories/{storyId}": {
      "schema": "stories",
      "description": "Collection of all generated stories."
    }
  }
}
